{
  "name": "collexion-campus",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "collexion-campus",
      "database_id": "bb49cd4e-508f-44cb-bb8b-ffd1fa44c866",
      "migrations_dir": "migrations"
    }
  ]
}
